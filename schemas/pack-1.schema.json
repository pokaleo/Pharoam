{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pharoam content pack manifest, format 1",
  "description": "The top block of a Pharoam file whose `schema` is `pack/1`.",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "pack/1" },
    "name": { "type": "string", "pattern": "^(?=.{1,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "min_app_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": { "type": ["string", "number"] },
    "licences": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": ["string", "number"] },
          "licence": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$" },
          "attribution": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        },
        "required": ["source", "licence"]
      }
    },
    "contents": {
      "default": {},
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [{ "pattern": "^(?=.{1,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$" }, { "pattern": "^(?!custom-)" }]
          }
        },
        "pathways": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(?=.{1,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "translations": {
      "default": [],
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
    }
  },
  "required": ["schema", "name", "version", "min_app_version", "publisher", "licences"]
}
