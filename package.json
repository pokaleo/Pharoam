{
  "name": "pharoam",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/core --noEmit && tsc -p packages/connector-folder --noEmit && tsc -p apps/web --noEmit",
    "dev": "pnpm --filter @pharoam/web dev",
    "build": "pnpm --filter @pharoam/web build",
    "docs:api": "typedoc",
    "content:build": "node tooling/content/bin/build-pack.ts",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm guard && pnpm knip && pnpm docs:api",
    "prepare": "husky",
    "guard": "node tooling/guard/bin/check-repo.ts",
    "guard:unlock": "node tooling/guard/bin/unlock.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
