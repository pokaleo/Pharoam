{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["tooling/**/*", "*.config.ts", "*.config.js"],
  "exclude": ["tooling/**/__fixtures__/**"]
}
