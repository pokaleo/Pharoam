{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  // Checks every package together for the API reference. The DOM lib serves the browser packages; each
  // package's own tsconfig sets its real environment and is checked separately by `pnpm typecheck`.
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["tooling/**/*", "*.config.ts", "packages/*/src/**/*"],
  "exclude": ["tooling/**/__fixtures__/**"]
}
